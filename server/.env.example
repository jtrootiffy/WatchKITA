# ---------------------------------------------------------------------------
# WatchKITA server environment
# Copy this file to server/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Required for movie/TV metadata, search, discovery, and TMDB id resolution.
# TMDB API bearer token. Read only by the backend and never exposed to the browser.
TMDB_API_KEY=your_tmdb_api_bearer_token_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Server
PORT=5000
NODE_ENV=development

# Browser origins allowed to call the API directly (comma separated).
# In production the app is same-origin on Vercel, so this is mostly for local use.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Enables the persistent watchlist sync in Supabase.
# Use the service_role key only in server-side environment variables.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
