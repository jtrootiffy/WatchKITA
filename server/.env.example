# ---------------------------------------------------------------------------
# WatchKITA server environment
# Copy this file to server/.env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Required. Create this in your Watchmode dashboard.
# This key is read only by the backend and must never be exposed to the browser.
WATCHMODE_API_KEY=your_watchmode_api_key_here

# Required for movie/TV playback metadata and TMDB id resolution.
# TMDB API key or bearer token. Read only by the backend and never exposed to the browser.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# Server
PORT=5000
NODE_ENV=development

# Browser origins allowed to call the API directly (comma separated).
# In production the app is same-origin on Vercel, so this is mostly for local use.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Enables the persistent catalog cache and watchlist sync in Supabase.
# Use the service_role key only in server-side environment variables.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
